// ============================================================
// OB1: Main [OB1]  —  LAD 直接版
// 功能: 面板读取 + 调用三个 GRAPH FB + 指示灯
// 语言: LAD (梯形图)
// 说明: 不经过 FB_Main，所有逻辑直接写在 OB1 里
// ============================================================

ORGANIZATION_BLOCK "Main"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.7

VAR
    fbReceive   : "FB_OP08_Receive";
    fbScrew     : "FB_OP08_Screw";
    fbSendOut   : "FB_OP08_SendOut";
END_VAR

BEGIN

// ================================================================
// Network 0: 仿真模式 — 用 M 位模拟 I 面板按钮
// ================================================================
// M100.0 = 模拟 I114.0 (运行准备)
// M100.1 = 模拟 I114.1 (启动)
// M100.2 = 模拟 I114.2 (停止 NC)
// M100.3 = 模拟 I114.3 (急停 NC)
// M100.4 = 模拟 I114.4 (复位)
// M100.5 = 模拟 I114.5 (自动模式)
// M100.6 = 1=启用仿真, 0=正常模式(实际硬件)
//
    NETWORK
    TITLE = '仿真模式开关';

    IF %M100.6 THEN
        %I114.0 := %M100.0;
        %I114.1 := %M100.1;
        %I114.2 := %M100.2;
        %I114.3 := %M100.3;
        %I114.4 := %M100.4;
        %I114.5 := %M100.5;
    END_IF;

// ================================================================
// Network 1: 调用 FB_OP08_Receive (接收工件)
// ================================================================
    NETWORK
    TITLE = '调用接收工件 FB';
    #fbReceive(
        bAutoMode := %I114.5,
        bStart    := %I114.1,
        bStop     := %I114.2,
        bEstop    := %I114.3,
        bReset    := %I114.4
    );

// ================================================================
// Network 2: 调用 FB_OP08_Screw (拧螺丝)
// ================================================================
    NETWORK
    TITLE = '调用拧螺丝 FB';
    #fbScrew(
        bEstop := %I114.3,
        bReset := %I114.4
    );

// ================================================================
// Network 3: 调用 FB_OP08_SendOut (送出工件)
// ================================================================
    NETWORK
    TITLE = '调用送出工件 FB';
    #fbSendOut(
        bEstop := %I114.3,
        bReset := %I114.4
    );

// ================================================================
// Network 4: 面板指示灯
// ================================================================
    NETWORK
    TITLE = '准备按钮灯';
    %Q116.4 := (%I114.5 = 1) AND (%I114.3 = 1);

    NETWORK
    TITLE = '启动按钮灯';
    %Q116.5 := ("握手信号".bReq_ScrewStart = 1) OR ("握手信号".bAck_ScrewDone = 1);

    NETWORK
    TITLE = '停止按钮灯';
    %Q116.6 := TRUE;

    NETWORK
    TITLE = '复位按钮灯';
    %Q116.7 := FALSE;

// ================================================================
// Network 5~8: 三色灯 + 蜂鸣器
// ================================================================
    NETWORK
    TITLE = '绿灯 — 运行中';
    %Q116.0 := (%I114.3 = 1) AND
               (("握手信号".bReq_ScrewStart = 1) OR ("握手信号".bAck_ScrewDone = 1));

    NETWORK
    TITLE = '黄灯 — 待料';
    %Q116.1 := (%I114.5 = 1) AND (%I114.3 = 1) AND
               ("握手信号".bReq_ScrewStart = 0) AND ("握手信号".bAck_ScrewDone = 0);

    NETWORK
    TITLE = '红灯 — 急停';
    %Q116.2 := (%I114.3 = 0);

    NETWORK
    TITLE = '蜂鸣器 — 急停';
    %Q116.3 := (%I114.3 = 0);

END_ORGANIZATION_BLOCK
